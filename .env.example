# Copy this file to .env beside the project. Never commit real API keys.
# Save changes; the next MCP tool call reloads valid endpoint/model settings.
API_ENDPOINT="https://YOUR_API_HOST/YOUR_API_PREFIX"
API_KEY="YOUR_API_KEY"
PROFILE="openai-images"
ORCHESTRATION_MODEL=""

MODEL_1_ID="YOUR_EXACT_IMAGE_MODEL_ID_1"
MODEL_1_NAME="YOUR_IMAGE_MODEL_NAME_1"
MODEL_1_ENABLED="true"
MODEL_1_OUTPUT_FORMAT=""
MODEL_1_SIZE=""
MODEL_1_QUALITY=""
MODEL_1_OUTPUT_TYPES=""
MODEL_1_MODES=""

MODEL_2_ID="YOUR_EXACT_IMAGE_MODEL_ID_2"
MODEL_2_NAME="YOUR_IMAGE_MODEL_NAME_2"
MODEL_2_ENABLED="false"
MODEL_2_OUTPUT_FORMAT=""
MODEL_2_SIZE=""
MODEL_2_QUALITY=""
MODEL_2_OUTPUT_TYPES=""
MODEL_2_MODES=""

MODEL_3_ID="YOUR_EXACT_IMAGE_MODEL_ID_3"
MODEL_3_NAME="YOUR_IMAGE_MODEL_NAME_3"
MODEL_3_ENABLED="false"
MODEL_3_OUTPUT_FORMAT=""
MODEL_3_SIZE=""
MODEL_3_QUALITY=""
MODEL_3_OUTPUT_TYPES=""
MODEL_3_MODES=""

# Empty output settings preserve provider defaults; explicit tool arguments override them.
# PROFILE: openai-images, omniroute, 9router, openai-responses,
# gemini, gemini-interactions, openrouter-images, fal.
# Pair OUTPUT_TYPES and MODES per model; both empty preserves legacy image configuration.
# Kinds: image, video, audio, 3d. Modes must match an implemented exact endpoint.
# fal uses the queue origin https://queue.fal.run and native Key authentication.
# Example: fal-ai/stable-audio / OUTPUT_TYPES=audio / MODES=text-to-audio.
# Do not configure image defaults for audio/video/3D endpoints unless their native schema accepts them.
# Responses additionally requires ORCHESTRATION_MODEL (the separate conversation model).
# Native Gemini uses aspect_ratio/image_size tool arguments, not Images SIZE/QUALITY.
# Enable editing only after verifying your gateway/model contract. No route is inferred.
EDIT_MODE=""
EDIT_ENCODING=""
EDIT_MAX_REFERENCES=""
EDIT_MASKS=""
EDIT_MASK_POLARITY=""
# Example native Images edit contract: multipart / image / 1 / true / transparent-edit.
# Mask polarity choices: transparent-edit, white-edit, black-edit. Not all routes accept masks.
