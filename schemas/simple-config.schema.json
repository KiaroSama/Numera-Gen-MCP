{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "api_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "api_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "models": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "output_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "enum": ["image", "video", "audio", "3d"] }
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 11,
            "items": {
              "type": "string",
              "enum": [
                "text-to-image", "image-to-image", "text-to-video", "image-to-video",
                "video-to-video", "text-to-audio", "audio-to-audio", "video-to-audio",
                "text-to-3d", "image-to-3d", "3d-to-3d"
              ]
            }
          },
          "output_format": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["png", "jpeg", "webp"]
              },
              {
                "type": "null"
              }
            ]
          },
          "size": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "quality": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "orchestration_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "profile": {
      "default": "openai-images",
      "type": "string",
      "enum": [
        "omniroute",
        "9router",
        "openai-images",
        "openai-responses",
        "gemini",
        "gemini-interactions",
        "openrouter-images",
        "fal"
      ]
    },
    "edit": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["multipart", "json", "generation"]
        },
        "encoding": {
          "type": "string",
          "enum": [
            "image",
            "image[]",
            "images",
            "image_urls",
            "input_references"
          ]
        },
        "maxReferences": {
          "default": 1,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 32
        },
        "masks": {
          "default": false,
          "type": "boolean"
        },
        "maskPolarity": {
          "type": "string",
          "enum": ["transparent-edit", "white-edit", "black-edit"]
        }
      },
      "required": ["mode", "encoding"],
      "additionalProperties": false
    }
  },
  "required": ["api_endpoint", "api_key", "models"],
  "additionalProperties": false
}
