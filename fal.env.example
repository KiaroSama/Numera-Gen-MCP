# Copy this file to fal.env and fill in your own values. Never commit real API keys.
# Point NUMERA_CONFIG at this file to use the fal profile:
#   NUMERA_CONFIG=/absolute/path/to/fal.env
# fal.env beside the installation root is NOT auto-discovered while .env exists;
# set NUMERA_CONFIG explicitly instead of renaming.
API_ENDPOINT="https://queue.fal.run"
API_KEY="YOUR_FAL_KEY"
PROFILE="fal"
ORCHESTRATION_MODEL=""

# MODEL_N_ID must be an exact fal endpoint implemented in native/media/fal_contract.rs.
# OUTPUT_TYPES must cover every artifact kind the endpoint returns.
# MODES must match the endpoint's exact supported mode(s).

# image
MODEL_1_ID="fal-ai/flux/dev"
MODEL_1_NAME="FLUX dev (text-to-image)"
MODEL_1_ENABLED="true"
MODEL_1_OUTPUT_TYPES="image"
MODEL_1_MODES="text-to-image"
MODEL_1_OUTPUT_FORMAT=""
MODEL_1_SIZE=""
MODEL_1_QUALITY=""

MODEL_2_ID="fal-ai/flux/dev/image-to-image"
MODEL_2_NAME="FLUX dev (image-to-image)"
MODEL_2_ENABLED="false"
MODEL_2_OUTPUT_TYPES="image"
MODEL_2_MODES="image-to-image"
MODEL_2_OUTPUT_FORMAT=""
MODEL_2_SIZE=""
MODEL_2_QUALITY=""

# video
MODEL_3_ID="fal-ai/kling-video/v2.5-turbo/pro/text-to-video"
MODEL_3_NAME="Kling 2.5 Turbo Pro (text-to-video)"
MODEL_3_ENABLED="false"
MODEL_3_OUTPUT_TYPES="video"
MODEL_3_MODES="text-to-video"
MODEL_3_OUTPUT_FORMAT=""
MODEL_3_SIZE=""
MODEL_3_QUALITY=""

MODEL_4_ID="fal-ai/kling-video/v2.1/standard/image-to-video"
MODEL_4_NAME="Kling 2.1 Standard (image-to-video)"
MODEL_4_ENABLED="false"
MODEL_4_OUTPUT_TYPES="video"
MODEL_4_MODES="image-to-video"
MODEL_4_OUTPUT_FORMAT=""
MODEL_4_SIZE=""
MODEL_4_QUALITY=""

MODEL_5_ID="fal-ai/cogvideox-5b/video-to-video"
MODEL_5_NAME="CogVideoX 5B (video-to-video)"
MODEL_5_ENABLED="false"
MODEL_5_OUTPUT_TYPES="video"
MODEL_5_MODES="video-to-video"
MODEL_5_OUTPUT_FORMAT=""
MODEL_5_SIZE=""
MODEL_5_QUALITY=""

# audio
MODEL_6_ID="fal-ai/stable-audio"
MODEL_6_NAME="Stable Audio (text-to-audio)"
MODEL_6_ENABLED="false"
MODEL_6_OUTPUT_TYPES="audio"
MODEL_6_MODES="text-to-audio"
MODEL_6_OUTPUT_FORMAT=""
MODEL_6_SIZE=""
MODEL_6_QUALITY=""

MODEL_7_ID="fal-ai/stable-audio-25/audio-to-audio"
MODEL_7_NAME="Stable Audio 2.5 (audio-to-audio)"
MODEL_7_ENABLED="false"
MODEL_7_OUTPUT_TYPES="audio"
MODEL_7_MODES="audio-to-audio"
MODEL_7_OUTPUT_FORMAT=""
MODEL_7_SIZE=""
MODEL_7_QUALITY=""

# 3d
MODEL_8_ID="fal-ai/hunyuan3d-v3/text-to-3d"
MODEL_8_NAME="Hunyuan3D v3 (text-to-3d)"
MODEL_8_ENABLED="false"
MODEL_8_OUTPUT_TYPES="3d,image"
MODEL_8_MODES="text-to-3d"
MODEL_8_OUTPUT_FORMAT=""
MODEL_8_SIZE=""
MODEL_8_QUALITY=""

MODEL_9_ID="fal-ai/trellis"
MODEL_9_NAME="TRELLIS (image-to-3d)"
MODEL_9_ENABLED="false"
MODEL_9_OUTPUT_TYPES="3d"
MODEL_9_MODES="image-to-3d"
MODEL_9_OUTPUT_FORMAT=""
MODEL_9_SIZE=""
MODEL_9_QUALITY=""

MODEL_10_ID="fal-ai/hyper3d/rodin"
MODEL_10_NAME="Hyper3D Rodin (text-to-3d + image-to-3d)"
MODEL_10_ENABLED="false"
MODEL_10_OUTPUT_TYPES="3d,image"
MODEL_10_MODES="text-to-3d,image-to-3d"
MODEL_10_OUTPUT_FORMAT=""
MODEL_10_SIZE=""
MODEL_10_QUALITY=""

MODEL_11_ID="fal-ai/trellis-2/retexture"
MODEL_11_NAME="TRELLIS 2 (3d-to-3d retexture)"
MODEL_11_ENABLED="false"
MODEL_11_OUTPUT_TYPES="3d"
MODEL_11_MODES="3d-to-3d"
MODEL_11_OUTPUT_FORMAT=""
MODEL_11_SIZE=""
MODEL_11_QUALITY=""

# Output kinds: image, video, audio, 3d.
# Modes: text-to-image, image-to-image, text-to-video, image-to-video, video-to-video,
#        text-to-audio, audio-to-audio, video-to-audio, text-to-3d, image-to-3d, 3d-to-3d.
# An endpoint absent from native/media/fal_contract.rs is rejected; add its evidenced
# contract there before declaring it here.
# Editing is declared separately and only works where the route accepts it:
EDIT_MODE=""
EDIT_ENCODING=""
EDIT_MAX_REFERENCES=""
EDIT_MASKS=""
EDIT_MASK_POLARITY=""
